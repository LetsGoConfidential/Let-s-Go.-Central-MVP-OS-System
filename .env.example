NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Never prefix this with NEXT_PUBLIC_ or use it in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Slack app configuration (server-only). Set the Slack OAuth redirect URL to
# {NEXT_PUBLIC_SITE_URL}/auth/integrations/slack/callback.
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
# Generate independent random values; never commit the real values.
OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
INTEGRATION_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-key

# Server-only AI provider settings. Use a model enabled for your API project.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-supported-model-id
# Optional USD per 1M tokens for the configured model; estimates stay hidden until both are set.
OPENAI_INPUT_USD_PER_1M_TOKENS=
OPENAI_OUTPUT_USD_PER_1M_TOKENS=

# Secret for the external scheduler calling POST /api/automation/worker.
AUTOMATION_WORKER_SECRET=replace-with-at-least-32-random-characters
